            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador_acceso\": \"admin\",\n  \"contrasena\": \"clave_equivocada\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
