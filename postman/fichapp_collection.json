    {
      "name": "3. Autenticación y Sesiones (T0.4)",
      "item": [
        {
          "name": "POST Login Admin (Obelisco FC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.datos && json.datos.token) {",
                  "        pm.collectionVariables.set('bearer_token', json.datos.token);",
                  "        console.log('Token Bearer guardado:', json.datos.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador_acceso\": \"admin\",\n  \"contrasena\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "POST Login Entrenador (Obelisco FC)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.datos && json.datos.token) {",
                  "        pm.collectionVariables.set('bearer_token', json.datos.token);",
                  "        console.log('Token Bearer Entrenador guardado:', json.datos.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificador_acceso\": \"entrenador\",\n  \"contrasena\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "GET Perfil Usuario Autenticado (/auth/me)",
          "request": {
            "method": "GET",
