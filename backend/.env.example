APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
TIMEZONE=America/Caracas

# Base de datos principal (PostgreSQL 16+)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fichapp_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Para testing o fallback en entornos sin PostgreSQL
DB_TEST_CONNECTION=sqlite
DB_TEST_DATABASE=:memory:
