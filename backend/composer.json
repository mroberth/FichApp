{
    "name": "fichapp/backend",
    "description": "API REST Backend en PHP 8.5 puro para FichApp",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "FichApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FichApp\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
